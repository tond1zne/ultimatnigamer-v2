# !!! TENTO SOUBOR JE JEN VZOR. Skutečné hodnoty NIKDY necommituj ani nesdílej. !!!
# Lokálně je dej do souboru .env (je v .gitignore). Na Vercelu do Settings > Environment Variables.

# PostgreSQL (Neon / Supabase). DATABASE_URL = pooled, DIRECT_URL = direct.
DATABASE_URL=""
DIRECT_URL=""

# Náhodný tajný řetězec, min. 32 znaků.
NEXTAUTH_SECRET=""

# Lokálně http://localhost:3000, na Vercelu tvoje https:// doména (bez lomítka na konci)
NEXTAUTH_URL="http://localhost:3000"

# E-maily přes Resend API (https://resend.com/api-keys). Klíč nikdy nedávej do kódu ani do chatu.
RESEND_API_KEY=""
MAIL_FROM="Ultimátní Gamer <noreply@tvoje-overena-domena.cz>"
